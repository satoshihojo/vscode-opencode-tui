#!/usr/bin/env bash

set -euo pipefail

if [[ "${1-}" == "session" && "${2-}" == "list" ]]; then
  printf '[]\n'
  exit 0
fi

if [[ "${1-}" == "db" && "${2-}" == "path" ]]; then
  db_path="${OPENCODE_EDIT_FAKE_DB_PATH:-}"
  if [[ -z "${db_path}" ]]; then
    db_path="$(mktemp -t opencode-tui-integration-test-db.XXXXXX.sqlite)"
  fi

  mkdir -p "$(dirname "${db_path}")"
  printf '%s\n' "${db_path}"
  exit 0
fi

sleep_seconds="${OPENCODE_EDIT_FAKE_OPENCODE_SLEEP:-30}"
printf '\033[?1049h\033[2J\033[H'
trap 'printf "\033[?1049l"' EXIT
printf 'OpenCode 1.14.22\n\n'
printf '  Queue diff fixes\n'
printf '  model: local/mock\n'
printf '  cwd: %s\n' "$(pwd)"
printf '  command: opencode %s\n\n' "${*:-<no-args>}"
printf '  Thinking...\n'
printf '  - reviewing pending edits\n'
printf '  - preparing file changes\n'
printf '  - waiting for next instruction\n\n'
printf '  Press Ctrl+C to exit\n'
sleep "${sleep_seconds}"
